# querysheriff collector configuration
#
# On first install, this file is copied to /etc/querysheriff-collector.yml
# Edit that copy, then run: systemctl restart querysheriff-collector

backend:
  # Base URL of the querysheriff backend. Use https unless the backend is reachable over a trusted
  # network (same host, same cluster) — the token below is sent as a bearer credential.
  url: https://querysheriff.example.com/api

  # Collector token issued by an admin. Authenticates this collector and identifies which server it reports as.
  token: qsc_CHANGE_ME

# PostgreSQL connection DSN.
postgres: postgresql://querysheriff_collector@localhost:5432/postgres

# Tail the PostgreSQL jsonlog.
logs:
  path: /var/log/postgresql
  # Let the collector delete old rotated .json files after a rotation switch, since PostgreSQL can't do it itself.
  delete_rotated: true
  # Restrict deletion to .json files, leaving the companion .log files for something else (e.g. logrotate) to reap.
  delete_rotated_json_only: false
